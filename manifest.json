{
  "manifest_version": 3,
  "name": "Yahoo-Killer",
  "version": "1.0.2",
  "description": "Redirects all search.yahoo.com traffic to Google Search and sets Google as default search engine",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "host_permissions": [
    "*://search.yahoo.com/*",
    "*://*.yahoo.com/*",
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Yahoo-Killer"
  },
  "incognito": "spanning"
}
