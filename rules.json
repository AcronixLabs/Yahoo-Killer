[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "regexSubstitution": "https://www.google.com/search?q=\\1"
      }
    },
    "condition": {
      "regexFilter": "^https?:\\/\\/([a-z0-9.-]+\\.)?yahoo\\.com\\/search\\?.*p=([^&]+).*",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 2,
    "priority": 2,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "scheme": "https",
          "host": "www.google.com",
          "path": "/search"
        }
      }
    },
    "condition": {
      "regexFilter": "^https?:\\/\\/([a-z0-9.-]+\\.)?search\\.yahoo\\.com\\/search.*",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 3,
    "priority": 3,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "scheme": "https",
          "host": "www.google.com"
        }
      }
    },
    "condition": {
      "regexFilter": "^https?:\\/\\/([a-z0-9.-]+\\.)?yahoo\\.com\\/.*",
      "resourceTypes": ["main_frame"]
    }
  }
]
