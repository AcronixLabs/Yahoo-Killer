[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "regexSubstitution": "https://www.google.com/search?q=\\1"
      }
    },
    "condition": {
      "regexFilter": "^https://[^/]*search\\.yahoo\\.com/search\\?.*p=([^&]+).*",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "url": "https://www.google.com/"
      }
    },
    "condition": {
      "urlFilter": "*://*search.yahoo.com/*",
      "resourceTypes": ["main_frame"]
    }
  }
]
